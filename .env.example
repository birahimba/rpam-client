# API publique des articles de blog (rpam-connect)
#
# Ces deux variables sont lues côté serveur uniquement (getStaticProps /
# getStaticPaths). Ne jamais les préfixer par NEXT_PUBLIC_ : le préfixe
# inlinerait la clé dans le bundle navigateur et la rendrait publique.
#
# En développement : copier ce fichier en .env.local (déjà git-ignoré).
# En déploiement : renseigner les deux variables dans le projet Vercel.

RPAM_CONNECT_API_KEY=
RPAM_CONNECT_URL=https://connect.rpam.fr
